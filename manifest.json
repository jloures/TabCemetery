{
  "manifest_version": 3,
  "name": "Tab Cemetery",
  "version": "2.0.2",
  "description": "Frees memory and clears clutter by parking inactive tabs. Restore any tab one click. Per-domain rules, tab-group awareness, idle detection.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "tabGroups",
    "idle",
    "notifications",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "utils.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "bury-active": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Bury the active tab now"
    },
    "restore-last": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Restore the last buried tab"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{d57bc4e9-2917-4fd5-8716-e4d6a19f201d}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
